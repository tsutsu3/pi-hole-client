---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import LandingPage from "../components/landing/LandingPage";
---

<StarlightPage
  frontmatter={{
    title: "Pi-hole client",
    description:
      "Unofficial Pi-hole client for Android. Monitor queries, toggle blocking, view stats, and manage multiple servers. Supports Pi-hole v6 and v5.",
    // Starlight would render "Pi-hole client | Pi-hole client" here.
    head: [{ tag: "title", content: "Pi-hole client | Android App for Pi-hole v6 & v5" }],
    template: "splash",
    tableOfContents: false,
    pagefind: false,
  }}
>
  <LandingPage />
</StarlightPage>

<style is:global>
  /* Starlight always renders a panel for the page title, but this page suppresses
     that title (see overrides/PageTitle.astro). Drop the resulting empty panel so
     the hero starts directly below the header, like the previous site. */
  main > .content-panel:first-child {
    display: none;
  }
  main > .content-panel {
    padding-top: 0;
  }
</style>
