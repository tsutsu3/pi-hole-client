---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import LandingPage from "../../components/landing/LandingPage";
---

<StarlightPage
  frontmatter={{
    title: "Pi-hole client",
    description:
      "無料で使える、Pi-hole v6・v5対応の非公式Androidクライアント。DNSクエリの確認、ブロックの管理、統計の表示、複数のPi-holeサーバーの操作ができます。",
    head: [
      { tag: "title", content: "Pi-hole client | Pi-hole v6・v5対応のAndroid管理アプリ" },
      {
        tag: "meta",
        attrs: { property: "og:title", content: "Pi-hole client" },
      },
      {
        tag: "meta",
        attrs: {
          property: "og:description",
          content: "AndroidからPi-holeサーバーを手軽に確認・管理できる非公式クライアントです。",
        },
      },
      {
        tag: "meta",
        attrs: {
          property: "og:url",
          content: "https://pi-hole-client.tsutsu3.com/ja/",
        },
      },
      {
        tag: "meta",
        attrs: { property: "og:locale", content: "ja_JP" },
      },
      {
        tag: "meta",
        attrs: { name: "twitter:title", content: "Pi-hole client" },
      },
      {
        tag: "meta",
        attrs: {
          name: "twitter:description",
          content: "AndroidからPi-holeサーバーを手軽に確認・管理できる非公式クライアントです。",
        },
      },
    ],
    template: "splash",
    tableOfContents: false,
    pagefind: false,
  }}
>
  <LandingPage locale="ja" />
</StarlightPage>

<style is:global>
  /* PageTitleを表示しないランディングページでは、空のタイトル領域も取り除く。 */
  main > .content-panel:first-child {
    display: none;
  }
  main > .content-panel {
    padding-top: 0;
  }
</style>
