{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pi-hole-client-website",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "pi-hole-client.tsutsu3.com",
      "custom_domain": true,
    },
  ],
}
